#!/usr/bin/env bash
#
# sauti — one command to boot the Sauti language-learning stack, one to kill it.
#
#   sauti up          start everything, wait for real health, print the URL
#   sauti down        stop everything (study data is kept)
#
# Two halves that behave like one thing:
#
#   1. The container stack (deploy/docker-compose.yml, project "sauti"):
#      db, api, web, proxy — served at http://sauti.localhost
#   2. The host ML voice services (deliberately NOT containerised: their
#      models + venvs are ~8 GB and this disk is nearly full):
#        tts  :8093  Kinyarwanda (YourTTS) + English (Kokoro) speech
#        asr  :8092  Kinyarwanda speech recognition / pronunciation scoring
#      Both bind 127.0.0.1 only. Logs and pidfiles live under
#      ~/.local/state/sauti/.
#
# This script is versioned at scripts/sauti and symlinked to ~/.local/bin/sauti.

set -euo pipefail

readonly SAUTI_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# Paths — resolve through the symlink so the repo copy is always the one that
# runs, wherever it was invoked from.
# ---------------------------------------------------------------------------

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _target="$(readlink "$_self")"
  [[ "$_target" == /* ]] && _self="$_target" || _self="$(dirname "$_self")/$_target"
done
readonly SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"

# ---------------------------------------------------------------------------
# Configuration. Every value is env-overridable — the self-test leans on this.
# ---------------------------------------------------------------------------

REPO_DIR="${SAUTI_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"
COMPOSE_FILE="${SAUTI_COMPOSE_FILE:-$REPO_DIR/deploy/docker-compose.yml}"
ENV_FILE="${SAUTI_ENV_FILE:-$REPO_DIR/deploy/.env.docker}"
ENV_EXAMPLE="${SAUTI_ENV_EXAMPLE:-$REPO_DIR/deploy/.env.docker.example}"
PROJECT="${SAUTI_PROJECT:-sauti}"
APP_URL="${SAUTI_URL:-http://sauti.localhost}"

STATE_DIR="${SAUTI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sauti}"
RUN_DIR="$STATE_DIR/run"
LOG_DIR="$STATE_DIR/logs"
LOCK_FILE="$RUN_DIR/sauti.lock"

# Host ML voice services.
TTS_PORT="${SAUTI_TTS_PORT:-8093}"
ASR_PORT="${SAUTI_ASR_PORT:-8092}"
TTS_DIR="${SAUTI_TTS_DIR:-$REPO_DIR/services/voice}"
ASR_DIR="${SAUTI_ASR_DIR:-/home/delta-x/rent-rwanda/services/voice}"
TTS_UVICORN="${SAUTI_TTS_UVICORN:-/home/delta-x/rent-rwanda/services/voice/.venv-yourtts/bin/uvicorn}"
ASR_UVICORN="${SAUTI_ASR_UVICORN:-$ASR_DIR/.venv-asr/bin/uvicorn}"
TTS_APP="${SAUTI_TTS_APP:-tts_app:app}"
ASR_APP="${SAUTI_ASR_APP:-asr_kinyarwanda_app:app}"

# Timeouts (seconds). The voice models are slow to warm; be patient but bounded.
TTS_TIMEOUT="${SAUTI_TTS_TIMEOUT:-210}"   # cold start ~1-2 min
ASR_TIMEOUT="${SAUTI_ASR_TIMEOUT:-150}"   # cold start ~1 min
APP_TIMEOUT="${SAUTI_APP_TIMEOUT:-120}"
STOP_GRACE="${SAUTI_STOP_GRACE:-10}"      # SIGTERM -> SIGKILL grace

readonly VOICE_SERVICES=(tts asr)
readonly CONTAINER_SERVICES=(db api web proxy)

# The app URL split for curl --resolve, so health checks never depend on how
# "*.localhost" happens to resolve (systemd-resolved answers ::1 only, while
# Docker may publish on 0.0.0.0). We always probe IPv4 loopback.
APP_HOST="${APP_URL#*://}"; APP_HOST="${APP_HOST%%/*}"
APP_PORT=80
if [[ "$APP_HOST" == *:* ]]; then APP_PORT="${APP_HOST##*:}"; APP_HOST="${APP_HOST%%:*}"; fi

# ---------------------------------------------------------------------------
# Output. Colour and marks only when stdout is a terminal.
# ---------------------------------------------------------------------------

if [[ -t 1 && "${NO_COLOR:-}" == "" && "${TERM:-dumb}" != "dumb" ]]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
  MARK_OK="✓"; MARK_BAD="✗"; MARK_DOT="•"
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""
  MARK_OK="ok"; MARK_BAD="!!"; MARK_DOT="-"
fi

say()  { printf '%s\n' "$*"; }
ok()   { printf '%s%s%s %s\n' "$C_GREEN" "$MARK_OK" "$C_RESET" "$*"; }
bad()  { printf '%s%s%s %s\n' "$C_RED" "$MARK_BAD" "$C_RESET" "$*"; }
info() { printf '%s%s%s %s\n' "$C_CYAN" "$MARK_DOT" "$C_RESET" "$*"; }
warn() { printf '%s%s warning:%s %s\n' "$C_YELLOW" "$MARK_DOT" "$C_RESET" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }

die() {
  printf '%ssauti: %s%s\n' "$C_RED" "$*" "$C_RESET" >&2
  exit 1
}

# die with extra "here is how to fix it" lines
die_hint() {
  local msg="$1"; shift
  printf '%ssauti: %s%s\n' "$C_RED" "$msg" "$C_RESET" >&2
  local line
  for line in "$@"; do printf '        %s\n' "$line" >&2; done
  exit 1
}

_tick_open=0
tick() { [[ -t 1 ]] || return 0; printf '.'; _tick_open=1; }
tick_end() { [[ $_tick_open -eq 1 ]] && { printf '\n'; _tick_open=0; }; return 0; }

# ---------------------------------------------------------------------------
# Generic helpers
# ---------------------------------------------------------------------------

# wait_until <timeout_s> <cmd...> — poll cmd until it succeeds or time runs out.
wait_until() {
  local timeout="$1"; shift
  local start=$SECONDS
  while ! "$@" >/dev/null 2>&1; do
    if (( SECONDS - start >= timeout )); then tick_end; return 1; fi
    tick
    sleep 2
  done
  tick_end
  return 0
}

port_in_use() {
  ss -ltnH "( sport = :$1 )" 2>/dev/null | grep -q .
}

# Best-effort "name pid" of whoever is listening. Root-owned listeners
# (docker-proxy) come back empty for an unprivileged ss — callers must cope.
port_listener() {
  ss -ltnpH "( sport = :$1 )" 2>/dev/null |
    sed -n 's/.*users:((\"\([^"]*\)\",pid=\([0-9]*\).*/\1 \2/p' | head -1
}

# PID that actually owns the listening socket — authoritative, unlike a
# process-name scan which also matches the shell that launched it.
port_pid() {
  ss -ltnpH "( sport = :$1 )" 2>/dev/null |
    sed -n 's/.*,pid=\([0-9]\{1,\}\),.*/\1/p' | head -1
}

# True if $1 is a live process whose command line runs $2, and is not merely a
# shell wrapper that mentions it (killing the wrapper would orphan the server).
proc_matches() {
  local cmd argv0
  [[ -r "/proc/$1/cmdline" ]] || return 1
  cmd="$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true)"
  [[ -n "$cmd" && "$cmd" == *"$2"* ]] || return 1
  argv0="${cmd%% *}"; argv0="${argv0##*/}"
  case "$argv0" in sh|bash|zsh|dash|fish|env|nohup|setsid|timeout) return 1;; esac
  return 0
}

need_dirs() { mkdir -p "$RUN_DIR" "$LOG_DIR"; }

# The lock lives on a file descriptor, and file descriptors are inherited. Any
# long-lived child we spawn must close LOCK_FD or it keeps the lock held for as
# long as it runs — which made `sauti down` report "another sauti command is
# already running" for the entire study session.
readonly LOCK_FD=9

acquire_lock() {
  need_dirs
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    die_hint "another sauti command is already running." \
             "Lock: $LOCK_FILE" \
             "Wait for it to finish, or check with: sauti status"
  fi
}

# ---------------------------------------------------------------------------
# Health checks — never trust a live process, always ask the endpoint.
# ---------------------------------------------------------------------------

health_tts() {
  curl -fsS -m 4 "http://127.0.0.1:$TTS_PORT/health" 2>/dev/null |
    grep -q '"ok"[[:space:]]*:[[:space:]]*true'
}

health_asr() {
  [[ "$(curl -s -o /dev/null -m 4 -w '%{http_code}' \
        "http://127.0.0.1:$ASR_PORT/docs" 2>/dev/null)" == "200" ]]
}

health_voice() { case "$1" in tts) health_tts;; asr) health_asr;; *) return 1;; esac; }

# /health answers ok as soon as uvicorn is serving, but the three voice engines
# load in a background thread and only flip to true minutes later. "Answering"
# and "can actually speak" are different things, and the owner should be told
# which one they have. Prints "loaded/total", e.g. "1/3".
tts_voices_loaded() {
  local body rest
  body="$(curl -fsS -m 4 "http://127.0.0.1:$TTS_PORT/health" 2>/dev/null)" || return 1
  [[ "$body" == *'"voices"'* ]] || return 1
  rest="${body#*\"voices\"}"
  printf '%s/%s' \
    "$(grep -o '":[[:space:]]*true' <<< "$rest" | wc -l)" \
    "$(grep -o '":[[:space:]]*\(true\|false\)' <<< "$rest" | wc -l)"
}

# The app health, through the proxy, exactly as the browser would reach it.
health_app() {
  curl -fsS -m 5 --resolve "$APP_HOST:$APP_PORT:127.0.0.1" \
    "$APP_URL/healthz" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Voice service metadata + lifecycle
# ---------------------------------------------------------------------------

voice_label() {
  case "$1" in
    tts) printf 'TTS  (Kinyarwanda + English speech, :%s)' "$TTS_PORT";;
    asr) printf 'ASR  (Kinyarwanda pronunciation scoring, :%s)' "$ASR_PORT";;
  esac
}
voice_port()    { case "$1" in tts) printf '%s' "$TTS_PORT";; asr) printf '%s' "$ASR_PORT";; esac; }
voice_dir()     { case "$1" in tts) printf '%s' "$TTS_DIR";;  asr) printf '%s' "$ASR_DIR";;  esac; }
voice_uvicorn() { case "$1" in tts) printf '%s' "$TTS_UVICORN";; asr) printf '%s' "$ASR_UVICORN";; esac; }
voice_app()     { case "$1" in tts) printf '%s' "$TTS_APP";;  asr) printf '%s' "$ASR_APP";;  esac; }
voice_timeout() { case "$1" in tts) printf '%s' "$TTS_TIMEOUT";; asr) printf '%s' "$ASR_TIMEOUT";; esac; }
pidfile()       { printf '%s/%s.pid' "$RUN_DIR" "$1"; }
logfile()       { printf '%s/%s.log' "$LOG_DIR" "$1"; }

pid_alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }

# PID from our pidfile, only if it is still a live process.
voice_pid() {
  local f; f="$(pidfile "$1")"
  [[ -f "$f" ]] || return 1
  local p; p="$(cat "$f" 2>/dev/null || true)"
  pid_alive "$p" || return 1
  printf '%s' "$p"
}

# Fallback: find a uvicorn serving our app that we did not start (e.g. left
# over from an earlier session). Matching on the app module keeps this from
# ever touching an unrelated process.
voice_pid_adopted() {
  local app pid; app="$(voice_app "$1")"

  # Whoever holds the port is the server, definitively.
  pid="$(port_pid "$(voice_port "$1")")"
  if [[ -n "$pid" ]] && proc_matches "$pid" "$app"; then
    printf '%s' "$pid"; return 0
  fi

  # Not listening yet (uvicorn binds only after startup warm-up), so scan.
  for pid in $(pgrep -u "$(id -u)" -f uvicorn 2>/dev/null || true); do
    proc_matches "$pid" "$app" || continue
    printf '%s' "$pid"; return 0
  done
  return 1
}

voice_any_pid() { voice_pid "$1" 2>/dev/null || voice_pid_adopted "$1"; }

start_voice() {
  local name="$1" port dir bin app log
  port="$(voice_port "$name")"; dir="$(voice_dir "$name")"
  bin="$(voice_uvicorn "$name")"; app="$(voice_app "$name")"; log="$(logfile "$name")"

  if health_voice "$name"; then
    ok "$(voice_label "$name") — already healthy"
    return 0
  fi

  # Alive but not answering yet: it is mid warm-up. Wait for it — do NOT start
  # a second one. This has to come before the port check, because uvicorn binds
  # the port only *after* the model finishes loading, so a warming service
  # leaves the port looking free for a minute or more.
  local pid; pid="$(voice_any_pid "$name" || true)"
  if [[ -n "$pid" ]]; then
    info "$(voice_label "$name") — already starting (pid $pid), waiting for warm-up"
    printf '%s' "$pid" > "$(pidfile "$name")"
    await_voice "$name"
    return $?
  fi

  # Nothing of ours, but the port is taken: a stranger. Say who, and stop.
  if port_in_use "$port"; then
    local who; who="$(port_listener "$port")"
    die_hint "port $port is in use by something that is not a Sauti voice service." \
             "Listener: ${who:-unknown (root-owned?)}" \
             "Free it, or point sauti elsewhere with SAUTI_${name^^}_PORT=<port>."
  fi

  [[ -x "$bin" ]] || die_hint "cannot start $name: uvicorn not found at $bin" \
      "The ML venvs live on the host by design (~8 GB, too big to containerise)." \
      "Override with SAUTI_${name^^}_UVICORN=/path/to/venv/bin/uvicorn"
  [[ -d "$dir" ]] || die "cannot start $name: working directory not found: $dir"

  need_dirs
  { printf '\n===== %s: starting %s at %s =====\n' "$name" "$app" "$(date -Is)"; } >> "$log"
  # 9>&- : do not hand our lock to a server that outlives this command.
  ( cd "$dir" && exec "$bin" "$app" --host 127.0.0.1 --port "$port" ) >> "$log" 2>&1 9>&- &
  local pid=$!
  printf '%s' "$pid" > "$(pidfile "$name")"
  disown "$pid" 2>/dev/null || true

  info "$(voice_label "$name") — starting (pid $pid), models warming up"
  await_voice "$name"
}

await_voice() {
  local name="$1" timeout; timeout="$(voice_timeout "$name")"
  if wait_until "$timeout" health_voice "$name"; then
    ok "$(voice_label "$name") — healthy"
    if [[ "$name" == tts ]]; then
      local v; v="$(tts_voices_loaded || true)"
      [[ -n "$v" && "${v%%/*}" == "0" ]] &&
        dim "     voices still loading in the background ($v) — the first phrase you play may take a moment"
    fi
    return 0
  fi
  bad "$(voice_label "$name") — did not become healthy within ${timeout}s"
  say "  last lines of $(logfile "$name"):"
  tail -n 15 "$(logfile "$name")" 2>/dev/null | sed 's/^/    /' || true
  return 1
}

stop_voice() {
  local name="$1" pid
  pid="$(voice_any_pid "$name" || true)"
  if [[ -z "$pid" ]]; then
    rm -f "$(pidfile "$name")"
    dim "  $name — not running"
    return 0
  fi

  kill -TERM "$pid" 2>/dev/null || true
  local start=$SECONDS
  while pid_alive "$pid"; do
    if (( SECONDS - start >= STOP_GRACE )); then
      warn "$name (pid $pid) ignored SIGTERM after ${STOP_GRACE}s — sending SIGKILL"
      kill -KILL "$pid" 2>/dev/null || true
      sleep 1
      break
    fi
    sleep 1
  done
  rm -f "$(pidfile "$name")"
  ok "$name stopped"
}

# ---------------------------------------------------------------------------
# Docker / compose
# ---------------------------------------------------------------------------

dc() {
  local args=(-p "$PROJECT" -f "$COMPOSE_FILE")
  # `up` refuses without the env file, but `down` and `logs` must keep working
  # even if it went missing — passing --env-file for a file that is not there
  # is a hard error in compose, and that must never block a shutdown.
  [[ -f "$ENV_FILE" ]] && args+=(--env-file "$ENV_FILE")
  docker compose "${args[@]}" "$@"
}

compose_containers() {
  docker ps -a --filter "label=com.docker.compose.project=$PROJECT" \
    --format '{{.Label "com.docker.compose.service"}}|{{.State}}|{{.Status}}' 2>/dev/null
}

container_state() {
  compose_containers | awk -F'|' -v s="$1" '$1==s {print $2; exit}'
}

project_volumes() {
  docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null
}

# The volume the study data actually lives in. Taken from the db container's
# own mounts when it exists — that cannot be wrong — and from a name match on
# the project's volumes when it does not.
db_volumes() {
  local c
  c="$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" \
       --filter "label=com.docker.compose.service=db" 2>/dev/null | head -1)"
  if [[ -n "$c" ]]; then
    docker inspect "$c" \
      --format '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{"\n"}}{{end}}{{end}}' \
      2>/dev/null | grep -v '^$' || true
    return 0
  fi
  project_volumes | grep -Ei 'pg|postgres|db' || true
}

# ---------------------------------------------------------------------------
# Preflight — fail early, and say exactly what to do about it.
# ---------------------------------------------------------------------------

preflight_docker() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed or not on PATH."
  if ! docker info >/dev/null 2>&1; then
    die_hint "cannot talk to the Docker daemon." \
             "Start it with:  sudo systemctl start docker" \
             "Then re-run:    sauti up"
  fi
  docker compose version >/dev/null 2>&1 ||
    die "the docker compose plugin is missing (need 'docker compose', not 'docker-compose')."
}

preflight_files() {
  if [[ ! -f "$COMPOSE_FILE" ]]; then
    die_hint "compose file not found: $COMPOSE_FILE" \
             "Expected it at deploy/docker-compose.yml inside $REPO_DIR." \
             "If your checkout lives elsewhere, set SAUTI_REPO=/path/to/sauti."
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    local how="Create it from the example:"
    if [[ -f "$ENV_EXAMPLE" ]]; then
      how="Create it with:  cp '$ENV_EXAMPLE' '$ENV_FILE'"
    else
      how="Create it from deploy/.env.docker.example (see docs/RUNNING.md)."
    fi
    die_hint "env file not found: $ENV_FILE" "$how" "Then fill in the secrets and re-run: sauti up"
  fi
}

# Port 80 belongs to the proxy. "Free, or already ours" is the bar.
preflight_app_port() {
  port_in_use "$APP_PORT" || return 0
  [[ "$(container_state proxy)" == "running" ]] && return 0
  # Docker publishes ports via root-owned docker-proxy; an unprivileged ss
  # shows no owner for those, so an unknown owner is most likely Docker's.
  local who; who="$(port_listener "$APP_PORT")"
  if [[ -z "$who" ]]; then
    warn "port $APP_PORT is held by a root-owned process (probably Docker). Continuing."
    return 0
  fi
  die_hint "port $APP_PORT is already in use by: $who" \
           "That is where the Sauti proxy needs to listen." \
           "Stop it, or serve the app on another port via SAUTI_URL=http://sauti.localhost:8080"
}

preflight_voice_ports() {
  local name port
  for name in "${VOICE_SERVICES[@]}"; do
    port="$(voice_port "$name")"
    port_in_use "$port" || continue
    health_voice "$name" && continue                    # ours and healthy
    [[ -n "$(voice_any_pid "$name" || true)" ]] && continue  # ours and warming
    local who; who="$(port_listener "$port")"
    die_hint "port $port ($name) is in use by something else: ${who:-unknown}" \
             "Stop that process, or move the service with SAUTI_${name^^}_PORT=<port>."
  done
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
${C_BOLD}sauti${C_RESET} — start and stop your language-learning stack (v$SAUTI_VERSION)

${C_BOLD}usage:${C_RESET} sauti <command> [options]

  up [--no-voice]      start voice services + containers, wait for health
  down                 stop everything (your study data is kept)
  status               what is running, and where
  logs [svc] [-f]      tail logs — svc: api web db proxy tts asr
  restart [svc]        restart everything, or one service
  rebuild [svc]        rebuild images, then bring the stack back up
  open                 open $APP_URL in your browser
  reset --yes-really   ${C_RED}DESTROYS the database volume${C_RESET} and all study data
  help                 this text

${C_BOLD}notes:${C_RESET}
  App             $APP_URL
  Containers      $PROJECT: ${CONTAINER_SERVICES[*]}  ($COMPOSE_FILE)
  Voice services  run on the host (models are ~8 GB — see docs/RUNNING.md)
  Logs / pids     $STATE_DIR
EOF
}

cmd_up() {
  local with_voice=1
  while (( $# )); do
    case "$1" in
      --no-voice) with_voice=0;;
      -h|--help) usage; return 0;;
      *) die_hint "unknown option for 'up': $1" "Try: sauti up [--no-voice]";;
    esac
    shift
  done

  local t0=$SECONDS

  # Fast path: everything already healthy — say so and get out of the way.
  local fast=1
  health_app || fast=0
  if (( with_voice && fast )); then
    local n; for n in "${VOICE_SERVICES[@]}"; do health_voice "$n" || { fast=0; break; }; done
  fi
  if (( fast )); then
    ok "Everything is already up."
    say ""
    say "  ${C_BOLD}$APP_URL${C_RESET}"
    return 0
  fi

  acquire_lock
  preflight_docker
  preflight_files
  preflight_app_port
  (( with_voice )) && preflight_voice_ports

  local voice_failed=0
  if (( with_voice )); then
    local n
    for n in "${VOICE_SERVICES[@]}"; do
      start_voice "$n" || voice_failed=1
    done
  else
    info "Skipping voice services (--no-voice) — lessons and reviews only, no speech."
  fi

  info "Starting containers…"
  dc up -d --remove-orphans

  info "Waiting for the app to answer at $APP_URL/healthz"
  if ! wait_until "$APP_TIMEOUT" health_app; then
    bad "the app did not become healthy within ${APP_TIMEOUT}s"
    say "  Recent container logs:"
    dc logs --tail 25 2>&1 | sed 's/^/    /' || true
    say "  More: sauti logs api -f"
    exit 1
  fi
  ok "App healthy"

  local elapsed=$(( SECONDS - t0 ))
  say ""
  if (( voice_failed )); then
    warn "one or more voice services are not healthy — speech features will not work."
    say "  Check: sauti logs tts   /   sauti logs asr"
  fi
  say "Ready in ${elapsed}s. Open:"
  say ""
  say "  ${C_BOLD}$APP_URL${C_RESET}"
  say ""
  (( voice_failed )) && exit 1
  return 0
}

cmd_down() {
  (( $# )) && die_hint "'down' takes no arguments (got: $1)" \
      "To delete study data you must ask explicitly: sauti reset --yes-really"
  acquire_lock

  local failed=0
  if [[ -f "$COMPOSE_FILE" ]] && docker info >/dev/null 2>&1; then
    info "Stopping containers…"
    # No -v: the Postgres volume, and the study data in it, stays.
    if dc down --remove-orphans; then
      ok "Containers stopped (database volume kept)"
    else
      bad "could not stop the containers — see the compose output above"
      failed=1
    fi
  else
    dim "  containers — Docker unreachable or no compose file, skipping"
  fi

  # Whatever happened to the containers, the host voice services still have to
  # come down: half a shutdown is worse than none.
  info "Stopping voice services…"
  local n
  for n in "${VOICE_SERVICES[@]}"; do stop_voice "$n"; done

  say ""
  if (( failed )); then
    bad "Voice services stopped, but the container stack did not come down cleanly."
    exit 1
  fi
  ok "All stopped. Your study data is safe — 'sauti up' picks up where you left off."
}

cmd_status() {
  say "${C_BOLD}Sauti${C_RESET}  ${C_DIM}$APP_URL${C_RESET}"
  say ""

  say "${C_BOLD}containers${C_RESET} ${C_DIM}(project: $PROJECT)${C_RESET}"
  if ! docker info >/dev/null 2>&1; then
    bad "  Docker daemon unreachable — try: sudo systemctl start docker"
  elif [[ ! -f "$COMPOSE_FILE" ]]; then
    bad "  compose file missing: $COMPOSE_FILE"
  else
    local svc state status found
    for svc in "${CONTAINER_SERVICES[@]}"; do
      found="$(compose_containers | awk -F'|' -v s="$svc" '$1==s {print; exit}')"
      if [[ -z "$found" ]]; then
        printf '  %s%-6s%s %s\n' "$C_DIM" "$svc" "$C_RESET" "not created"
      else
        state="${found#*|}"; state="${state%%|*}"
        status="${found##*|}"
        if [[ "$state" == "running" ]]; then
          printf '  %-6s %s%s%s  %s\n' "$svc" "$C_GREEN" "$MARK_OK" "$C_RESET" "$status"
        else
          printf '  %-6s %s%s%s  %s\n' "$svc" "$C_RED" "$MARK_BAD" "$C_RESET" "$state ($status)"
        fi
      fi
    done
  fi

  say ""
  say "${C_BOLD}voice services${C_RESET} ${C_DIM}(host, 127.0.0.1 only)${C_RESET}"
  local n pid
  for n in "${VOICE_SERVICES[@]}"; do
    pid="$(voice_any_pid "$n" || true)"
    if health_voice "$n"; then
      local extra=""
      if [[ "$n" == tts ]]; then
        local v; v="$(tts_voices_loaded || true)"
        if [[ -n "$v" && "${v%%/*}" == "0" ]]; then
          extra=" ${C_YELLOW}voices $v — still loading, speech not ready${C_RESET}"
        elif [[ -n "$v" ]]; then
          extra=" ${C_DIM}voices $v${C_RESET}"
        fi
      fi
      printf '  %-4s %s%s%s  healthy on :%s%s%s\n' "$n" "$C_GREEN" "$MARK_OK" "$C_RESET" \
        "$(voice_port "$n")" "${pid:+ (pid $pid)}" "$extra"
    elif [[ -n "$pid" ]]; then
      printf '  %-4s %s%s%s  running but not answering yet — still warming up (pid %s)\n' \
        "$n" "$C_YELLOW" "$MARK_DOT" "$C_RESET" "$pid"
    else
      printf '  %-4s %s%s%s  down\n' "$n" "$C_RED" "$MARK_BAD" "$C_RESET"
    fi
  done

  say ""
  say "${C_BOLD}app${C_RESET}"
  if health_app; then
    printf '  %s%s%s  %s/healthz answering\n' "$C_GREEN" "$MARK_OK" "$C_RESET" "$APP_URL"
  else
    printf '  %s%s%s  %s not answering\n' "$C_RED" "$MARK_BAD" "$C_RESET" "$APP_URL"
  fi

  say ""
  say "${C_BOLD}data${C_RESET}"
  local vols; vols="$(db_volumes || true)"
  if [[ -n "$vols" ]]; then
    local v
    while IFS= read -r v; do
      [[ -n "$v" ]] || continue
      printf '  %s%s%s  %s %s(your lessons, reviews and recordings)%s\n' \
        "$C_GREEN" "$MARK_OK" "$C_RESET" "$v" "$C_DIM" "$C_RESET"
    done <<< "$vols"
  else
    printf '  %s%s%s  no database volume yet (created on first "sauti up")\n' \
      "$C_YELLOW" "$MARK_DOT" "$C_RESET"
  fi
  local others; others="$(project_volumes | wc -l)"
  local dbcount; dbcount="$(printf '%s' "$vols" | grep -c . || true)"
  if (( others > dbcount )); then
    dim "  + $(( others - dbcount )) other volume(s) (caches — safe to lose)"
  fi

  say ""
  dim "  logs: $LOG_DIR    pids: $RUN_DIR"
}

cmd_logs() {
  local svc="" follow=0
  while (( $# )); do
    case "$1" in
      -f|--follow) follow=1;;
      api|web|db|proxy|tts|asr) svc="$1";;
      -h|--help) usage; return 0;;
      *) die_hint "unknown argument for 'logs': $1" \
                  "Try: sauti logs [api|web|db|proxy|tts|asr] [-f]";;
    esac
    shift
  done

  case "$svc" in
    tts|asr)
      local f; f="$(logfile "$svc")"
      [[ -f "$f" ]] || die "no log file yet for $svc ($f) — has it ever started?"
      if (( follow )); then tail -n 200 -f "$f"; else tail -n 200 "$f"; fi
      ;;
    "")
      # No service named: containers together, plus a pointer to the host logs.
      preflight_docker; preflight_files
      if (( follow )); then dc logs --tail 100 -f; else dc logs --tail 100; fi
      dim "  voice service logs are separate: sauti logs tts | sauti logs asr"
      ;;
    *)
      preflight_docker; preflight_files
      if (( follow )); then dc logs --tail 200 -f "$svc"; else dc logs --tail 200 "$svc"; fi
      ;;
  esac
}

cmd_restart() {
  local svc="${1:-}"
  (( $# > 1 )) && die_hint "'restart' takes at most one service (got: $*)" \
      "Try: sauti restart [api|web|db|proxy|tts|asr]"
  acquire_lock

  case "$svc" in
    tts|asr)
      stop_voice "$svc"
      start_voice "$svc"
      ;;
    api|web|db|proxy)
      preflight_docker; preflight_files
      info "Restarting $svc…"
      dc restart "$svc"
      wait_until "$APP_TIMEOUT" health_app && ok "App healthy" || bad "App not answering after restart"
      ;;
    "")
      preflight_docker; preflight_files
      info "Restarting containers…"
      dc restart
      local n
      for n in "${VOICE_SERVICES[@]}"; do stop_voice "$n"; start_voice "$n" || true; done
      wait_until "$APP_TIMEOUT" health_app && ok "App healthy" || bad "App not answering after restart"
      ;;
    *) die_hint "unknown service: $svc" "Known: api web db proxy tts asr";;
  esac
}

cmd_rebuild() {
  local svc="${1:-}"
  (( $# > 1 )) && die_hint "'rebuild' takes at most one service (got: $*)" \
      "Try: sauti rebuild [api|web|db|proxy]"
  case "$svc" in
    tts|asr) die_hint "'$svc' is a host service, not an image — nothing to rebuild." \
                      "Restart it instead: sauti restart $svc";;
    ""|api|web|db|proxy) ;;
    *) die_hint "unknown service: $svc" "Known: api web db proxy";;
  esac

  acquire_lock
  preflight_docker
  preflight_files

  info "Rebuilding images${svc:+ for $svc}…"
  if [[ -n "$svc" ]]; then dc build "$svc"; else dc build; fi

  info "Bringing the stack back up…"
  dc up -d --remove-orphans
  if wait_until "$APP_TIMEOUT" health_app; then
    ok "App healthy — $APP_URL"
  else
    bad "App did not become healthy within ${APP_TIMEOUT}s — try: sauti logs api"
    exit 1
  fi
}

cmd_open() {
  if ! health_app; then
    warn "the app is not answering yet at $APP_URL — opening anyway."
    warn "if the page fails to load, run: sauti up"
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$APP_URL" >/dev/null 2>&1 &
    ok "Opened $APP_URL"
  else
    say "$APP_URL"
  fi
}

cmd_reset() {
  local confirmed=0
  while (( $# )); do
    case "$1" in
      --yes-really) confirmed=1;;
      *) die_hint "unknown option for 'reset': $1" "Try: sauti reset --yes-really";;
    esac
    shift
  done

  if (( ! confirmed )); then
    if [[ ! -t 0 ]]; then
      die_hint "'reset' deletes the database volume and every lesson, review and recording in it." \
               "It refuses to run unattended. If you truly mean it:" \
               "    sauti reset --yes-really"
    fi
    say "${C_RED}${C_BOLD}This deletes the Sauti database volume.${C_RESET}"
    say "Every lesson, review, streak and recording stored in it is gone for good."
    printf 'Type %sDELETE%s to confirm: ' "$C_BOLD" "$C_RESET"
    local answer=""
    read -r answer || true
    [[ "$answer" == "DELETE" ]] || die "not confirmed — nothing was deleted."
  fi

  acquire_lock
  preflight_docker
  preflight_files
  info "Removing containers and volumes…"
  dc down -v --remove-orphans
  local n
  for n in "${VOICE_SERVICES[@]}"; do stop_voice "$n"; done
  ok "Reset complete. The next 'sauti up' starts from an empty database."
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    up)              cmd_up "$@";;
    down|stop|kill)  cmd_down "$@";;
    status|ps)       cmd_status "$@";;
    logs)            cmd_logs "$@";;
    restart)         cmd_restart "$@";;
    rebuild)         cmd_rebuild "$@";;
    open)            cmd_open "$@";;
    reset)           cmd_reset "$@";;
    help|-h|--help)  usage;;
    --version)       say "sauti $SAUTI_VERSION";;
    *)
      printf '%ssauti: unknown command: %s%s\n\n' "$C_RED" "$cmd" "$C_RESET" >&2
      usage >&2
      exit 2
      ;;
  esac
}

# SAUTI_SOURCE_ONLY lets scripts/sauti-selftest.sh source this file and poke at
# the helpers directly (that is how the "kill the server, not its wrapper" bug
# stays fixed). Nothing else should set it.
[[ -n "${SAUTI_SOURCE_ONLY:-}" ]] || main "$@"
