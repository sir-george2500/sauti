{
	# No admin API and no automatic HTTPS: this is http-only on one machine.
	# (The global options block has to be the very first thing in a Caddyfile,
	# comments included — hence the explanation below rather than above.)
	admin off
	auto_https off
	persist_config off
}

# Single front door for the local stack: http://sauti.localhost (and
# http://localhost / http://127.0.0.1 — the site block is bound to the port,
# not a hostname, so every local name that reaches :80 is served).
#
# One origin for the browser means one CORS origin for the API and no
# mixed-port cookie games: the refresh cookie set by /api/v1/auth is a plain
# host cookie on sauti.localhost.
:80 {
	encode gzip

	# WebSockets: the study buddy and conversation practice live under
	# /api/v1/ws/*. Caddy's reverse_proxy proxies the Upgrade handshake
	# transparently, but the long-lived connection must not be timed out.
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy api:8000
	}

	# /ws/* is proxied too so an unversioned WS path keeps working.
	handle /ws/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
		level ERROR
	}
}
