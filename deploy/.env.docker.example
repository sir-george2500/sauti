# Template for deploy/.env.docker — the real file is gitignored and holds live
# secrets. Copy it and fill in the blanks (the values are the same ones the repo
# root .env already carries):
#
#   cp deploy/.env.docker.example deploy/.env.docker
#
# Everything that is a deployment fact rather than a secret (POSTGRES_URL,
# APP_BASE_URL, VOICE_SERVICE_URL, SAUTI_FAKE_AI, …) is set in
# docker-compose.yml and does NOT belong here — compose `environment:` wins over
# `env_file:`, so a stray copy here would be silently ignored.

# ---- Auth ----
# openssl rand -hex 32   (must be >= 32 bytes or the API refuses to start)
JWT_SECRET=""
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# ---- LLM (conversation partner + coach) ----
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"

# ---- Cloudinary (TTS "synthesize once, fetch forever" cache) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email (verification / password reset) ----
# Leave SMTP_HOST/USERNAME/PASSWORD empty to use the console mailer: links are
# printed to `docker compose logs api` instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_STARTTLS="true"
APP_MAIL_FROM="Sauti <no-reply@sauti.local>"
