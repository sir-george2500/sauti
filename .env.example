# ---- Database (Supabase used as plain Postgres; app tables live in schema "sauti") ----
POSTGRES_URL=""
DATABASE_SCHEMA="sauti"

# ---- Auth ----
JWT_SECRET=""            # openssl rand -hex 32
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# ---- LLM (conversation partner + coach) ----
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"

# ---- Email ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
APP_MAIL_FROM="Sauti <no-reply@example.com>"

# ---- Real speech stack (leave VOICE_SERVICE_URL empty for the stub backend) ----
# sauti two-voice Kinyarwanda TTS (services/voice/tts_app.py — female + male)
VOICE_SERVICE_URL="http://127.0.0.1:8093"
# rent-rwanda Kinyarwanda ASR (NeMo FastConformer) for STT / pronunciation scoring
SAUTI_ASR_URL="http://127.0.0.1:8092"
# Cloudinary synthesize-once TTS cache
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- URLs ----
APP_BASE_URL="http://localhost:8000"
APP_FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
